# Kopier til .env.local og fyll inn verdier fra Supabase Dashboard → Project Settings → API.
# .env.local er ignorert av git (*.local).
#
# Bruk KUN den offentlige nøkkelen (publishable «sb_publishable_…» eller legacy «anon»).
# ALDRI service_role- eller secret-nøkkel her – alt med VITE_-prefiks havner i nettleseren.
VITE_SUPABASE_URL=https://<prosjekt-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
